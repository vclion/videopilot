# DeepSeek 配置（AI 总结功能必填）
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# B 站登录态（可选，强烈建议填写）
# 大部分 B 站视频的 AI 字幕仅登录态可见；
# 获取方式：登录 bilibili.com -> 浏览器开发者工具 -> 应用/存储 -> Cookies -> SESSDATA
BILIBILI_SESSDATA=
# 站点公开地址（SEO 使用：canonical、sitemap、robots.txt）
# 上线后填写完整网址，末尾不要带斜杠
SITE_URL=https://example.com

# 会员配置（模拟支付阶段使用；真实支付接入后仍可复用）
MEMBERSHIP_PLAN_DAYS=30
MEMBERSHIP_PRICE_CENTS=990
MEMBERSHIP_PLAN_NAME=30天会员

# 用户账号与 JWT
# 启动前必填：JWT_SECRET 使用随机长字符串（至少 32 位），无默认密钥
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080
# 仅首次创建管理员时使用；密码至少 12 位且不超过 72 个 UTF-8 字节
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 本地语音转写备用链路（没有平台字幕时启用）
ASR_ENABLED=true
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=auto
ASR_MAX_MINUTES=60

# Qwen：视频问答、追问改写和画面索引；DeepSeek 继续用于 AI 总结
# 由服务提供方确认接口地址与模型名称
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=
QWEN_VL_MODEL=

# 默认视频问答使用 Qwen；false 为显式切回旧的 DeepSeek 字幕问答
VIDEO_ANALYSIS_ENABLED=true
# 每次索引最多处理多少个新片段；后续提问续建，10 秒一片
VIDEO_INDEX_MAX_CHUNKS_PER_RUN=180
# Qwen 根据问题含义选择的核心片段数量（保留原配置名称）
VIDEO_RETRIEVAL_TOP_K=3
VIDEO_MAX_CLIPS_PER_QUESTION=6
VIDEO_MAX_MINUTES=30
VIDEO_SOURCE_MAX_MB=300
VIDEO_CACHE_MAX_MB=1024
# 缓存闲置超过此时间后清理
VIDEO_CACHE_TTL_HOURS=168
